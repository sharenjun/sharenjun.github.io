sharenjun.github.io/media/posts/6/responsive/1-2-md.png 768w ,https://sharenjun.github.io/media/posts/6/responsive/1-2-lg.png 1024w ,https://sharenjun.github.io/media/posts/6/responsive/1-2-xl.png 1360w ,https://sharenjun.github.io/media/posts/6/responsive/1-2-2xl.png 1600w\"></figure>\n<figure class=\"post__image\"><img loading=\"lazy\" src=\"https://sharenjun.github.io/media/posts/6/2-2.png\" alt=\"Image description\" width=\"1900\" height=\"1490\"  sizes=\"100vw\" srcset=\"https://sharenjun.github.io/media/posts/6/responsive/2-2-xs.png 300w ,https://sharenjun.github.io/media/posts/6/responsive/2-2-sm.png 480w ,https://sharenjun.github.io/media/posts/6/responsive/2-2-md.png 768w ,https://sharenjun.github.io/media/posts/6/responsive/2-2-lg.png 1024w ,https://sharenjun.github.io/media/posts/6/responsive/2-2-xl.png 1360w ,https://sharenjun.github.io/media/posts/6/responsive/2-2-2xl.png 1600w\"></figure>\n<figure class=\"post__image\"><img loading=\"lazy\" src=\"https://sharenjun.github.io/media/posts/6/3.png\" alt=\"Image description\" width=\"780\" height=\"193\"  sizes=\"100vw\" srcset=\"https://sharenjun.github.io/media/posts/6/responsive/3-xs.png 300w ,https://sharenjun.github.io/media/posts/6/responsive/3-sm.png 480w ,https://sharenjun.github.io/media/posts/6/responsive/3-md.png 768w ,https://sharenjun.github.io/media/posts/6/responsive/3-lg.png 1024w ,https://sharenjun.github.io/media/posts/6/responsive/3-xl.png 1360w ,https://sharenjun.github.io/media/posts/6/responsive/3-2xl.png 1600w\"></figure>",
